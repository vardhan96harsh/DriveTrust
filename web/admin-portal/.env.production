# DriveTrust Ultra Production Admin Portal Environment Configuration

# 1. Microservices API Gateway Target
NEXT_PUBLIC_API_URL=https://api.drivetrust.in

# 2. Google Maps Platform Credentials
# Replace with restricted Google Cloud production key for maps, directions, and geocoding:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# 3. Environment & Telemetry Settings
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
